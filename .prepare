#!/bin/sh
# r-universe's post-checkout, pre-build hook (r-universe-org/help#411):
# entrypoint.sh runs `(cd $PKGDIR; sh .prepare)` in a subshell, then later
# packages a source tarball via `R CMD build` -- .Rbuildignore correctly
# strips vendor/ from that tarball, so a subsequent `R CMD INSTALL` on the
# tarball never sees vendor/catboost, submodule or not. Populate a fixed
# path OUTSIDE the package tree instead, so it survives the tarball
# boundary; configure's fallback check picks it up (catboost-8z4.126.1).
set -eu

# r-universe's build image doesn't map DESCRIPTION's SystemRequirements
# free-text mentions (clang, Cython) to apt packages; install directly
# here. Never fail the script on any of this -- the vendor-source
# population below must still run even if these do (catboost-8z4.126.2).
apt_install() {
  command -v apt-get >/dev/null 2>&1 || return 0
  if command -v sudo >/dev/null 2>&1; then
    sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" \
      || echo "*** .prepare: apt-get install (sudo) $* failed, continuing anyway" >&2
  else
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" \
      || echo "*** .prepare: apt-get install $* failed, continuing anyway" >&2
  fi
}

if ! command -v clang >/dev/null 2>&1 || ! command -v clang++ >/dev/null 2>&1; then
  apt_install clang lld
fi

# Debian's cython package ships /usr/bin/cython3, but configure only
# checks for a binary literally named 'cython' (CATBOOSTR_CYTHON's
# default lookup, configure:403-405).
if ! command -v cython >/dev/null 2>&1; then
  apt_install cython3
  if ! command -v cython >/dev/null 2>&1 && command -v cython3 >/dev/null 2>&1; then
    CYTHON3_PATH=$(command -v cython3)
    ln -sf "$CYTHON3_PATH" "$(dirname "$CYTHON3_PATH")/cython" \
      || echo "*** .prepare: could not symlink cython3 -> cython, continuing anyway" >&2
  fi
fi

FALLBACK_ROOT="/tmp/catboostr-runiverse-vendor-cache"

tools/vendor/acquire.sh "${FALLBACK_ROOT}/catboost"
tools/vendor/acquire-thirdparty.sh "${FALLBACK_ROOT}/thirdparty"
