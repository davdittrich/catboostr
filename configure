#! /bin/sh
# catboostr fork-owned configure.
#
# Replaces upstream's configure (vendor/catboost/catboost/R-package/configure,
# generated by GNU Autoconf 2.69), which offers three CatBoost-dynlib
# acquisition routes at lines 1756-1793:
#   (a) a caller-supplied $CATBOOST_DYNLIB path, copied into src/,
#   (b) a pre-existing src/libcatboostr.<so|dylib>, used as-is,
#   (c) catboost_download_dynlib() (R/install.R): a network fetch of a
#       prebuilt shared object from a GitHub release, run when (a) and (b)
#       both miss.
# A CRAN source-package install has no network access, so route (c) cannot
# exist in a CRAN-shippable configure -- it is deleted outright below, not
# gated. Route (b) is replaced by a from-source CMake build of the pinned
# vendor/catboost snapshot (see P1.2/P1.3). Route (a) is kept for local
# development only and is REFUSED in release/CRAN builds (see "CATBOOST_DYNLIB
# policy" below) -- an env-var-selected prebuilt shared object is the same
# hazard class as the deleted download, minus the network.
#
# POSIX sh: written to run under both bash-as-/bin/sh (Linux) and macOS's
# /bin/sh, since macOS is in scope for R1 (Linux is the only OS this was
# actually run on by this ticket's own author -- see docs/phase-1/P1.4-report.md).

set -eu

PKG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$PKG_ROOT"

# --------------------------------------------------------------------------
# 1. Locate R and forward its toolchain configuration.
#
# CRAN packages MUST use R's own configured compiler/flags, not a hardcoded
# one (portability across CRAN's build machines; ABI/hardening-flag
# consistency with the running R). Every value below comes straight from
# `R CMD config`, never invented here.
# --------------------------------------------------------------------------
: "${R_HOME:=$(R RHOME)}"
R_BIN="${R_HOME}/bin/R"

R_CC=$("${R_BIN}" CMD config CC)
R_CXX=$("${R_BIN}" CMD config CXX)
R_CFLAGS=$("${R_BIN}" CMD config CFLAGS)
R_CXXFLAGS=$("${R_BIN}" CMD config CXXFLAGS)
R_CPPFLAGS=$("${R_BIN}" CMD config CPPFLAGS)
R_LDFLAGS=$("${R_BIN}" CMD config LDFLAGS)

# R's real include dir: NOT always ${R_HOME}/include (e.g. distro-packaged R
# splits it out to /usr/include/R). `R CMD config --cppflags` is the
# authoritative source (P1.3 finding) -- take its first -I token.
R_INCLUDE_DIR=$("${R_BIN}" CMD config --cppflags | tr ' ' '\n' | grep '^-I' | head -n1 | sed 's/^-I//')
if [ ! -f "${R_INCLUDE_DIR}/R.h" ]; then
  echo "*** R_INCLUDE_DIR (${R_INCLUDE_DIR}, from R CMD config --cppflags) has no R.h -- cannot forward R's include path (see P1.3)." >&2
  exit 1
fi

echo "*** forwarding R's toolchain configuration:"
echo "***   CC       = $R_CC"
echo "***   CXX      = $R_CXX"
echo "***   CFLAGS   = $R_CFLAGS"
echo "***   CXXFLAGS = $R_CXXFLAGS"
echo "***   CPPFLAGS = $R_CPPFLAGS"
echo "***   LDFLAGS  = $R_LDFLAGS"
echo "***   R include dir = $R_INCLUDE_DIR"

# --------------------------------------------------------------------------
# 2. CATBOOST_DYNLIB policy (spec 10.4, closed).
#
# Kept for DEVELOPMENT use only, spelled exactly as upstream's env var.
# Release/CRAN builds (the default -- CATBOOSTR_DEV_BUILD unset) REFUSE it
# outright: loading a shared object selected by an environment variable is
# the same hazard class as the deleted network download (route (c) above),
# minus the network. Development builds (CATBOOSTR_DEV_BUILD=1) accept it,
# but must print the resolved path and its SHA256 so what is being loaded is
# never silent.
# --------------------------------------------------------------------------
if [ -n "${CATBOOST_DYNLIB:-}" ]; then
  if [ "${CATBOOSTR_DEV_BUILD:-0}" != "1" ]; then
    echo "*** CATBOOST_DYNLIB is set (${CATBOOST_DYNLIB}), but this is a release build." >&2
    echo "*** Loading a shared object selected by an environment variable is refused" >&2
    echo "*** in release/CRAN builds -- same hazard class as the deleted download route." >&2
    echo "*** Unset CATBOOST_DYNLIB, or set CATBOOSTR_DEV_BUILD=1 for a local development build." >&2
    exit 1
  fi

  if [ ! -f "$CATBOOST_DYNLIB" ]; then
    if [ -f "src/$CATBOOST_DYNLIB" ]; then
      CATBOOST_DYNLIB="src/$CATBOOST_DYNLIB"
    else
      echo "*** CATBOOST_DYNLIB=$CATBOOST_DYNLIB does not exist." >&2
      exit 1
    fi
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    DYNLIB_SHA256=$(sha256sum "$CATBOOST_DYNLIB" | awk '{print $1}')
  else
    DYNLIB_SHA256=$(shasum -a 256 "$CATBOOST_DYNLIB" | awk '{print $1}')
  fi

  echo "*** development build: using CATBOOST_DYNLIB path: $CATBOOST_DYNLIB"
  echo "*** development build: CATBOOST_DYNLIB sha256: $DYNLIB_SHA256"

  mkdir -p inst/libs
  cp -f "$CATBOOST_DYNLIB" inst/libs/libcatboostr.so
  echo "*** installed $CATBOOST_DYNLIB -> inst/libs/libcatboostr.so (development build, unverified provenance)"
  exit 0
fi

# --------------------------------------------------------------------------
# 3. From-source build: disposable copy of the pinned vendor/catboost tree.
#
# Never build in place -- Conan 2.x's CMakeToolchain writes
# CMakeUserPresets.json into the configured source tree unconditionally, and
# vendor/catboost/ is a read-only pin (tag v1.2.10). The copy always lives
# under a disposable build dir, never under PKG_ROOT.
# --------------------------------------------------------------------------
VENDOR_SRC="${PKG_ROOT}/vendor/catboost"
if [ ! -d "$VENDOR_SRC" ]; then
  echo "*** ${VENDOR_SRC} not found -- this fork requires the pinned vendor/catboost snapshot." >&2
  exit 1
fi

WORKDIR="${CATBOOSTR_BUILD_DIR:-}"
if [ -z "$WORKDIR" ]; then
  WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/catboostr-build.XXXXXX")
fi
SRC_COPY="${WORKDIR}/src-copy"
BUILD_DIR="${WORKDIR}/build"

rm -rf "$SRC_COPY"
mkdir -p "$SRC_COPY"
cp -a "${VENDOR_SRC}/." "$SRC_COPY/"
rm -rf "${SRC_COPY}/.git"

# Inject the fork's own R target AFTER upstream's own add_subdirectory(catboost)
# chain has run, so every upstream target this links against already exists
# (CMAKE_PROJECT_TOP_LEVEL_INCLUDES runs too early for this -- P1.3 finding).
# Two-argument add_subdirectory(source_dir binary_dir) builds the fork's real
# src/ in place; no fork source is copied into the disposable tree.
printf '\nadd_subdirectory(%s %s)\n' "$PKG_ROOT/src" '${CMAKE_BINARY_DIR}/catboostr-fork-build' \
  >> "${SRC_COPY}/CMakeLists.txt"

# --------------------------------------------------------------------------
# 3b. Third-party sources that are NOT inside the pinned vendor/catboost
# snapshot, built here from pinned, SHA256-verified tarballs.
#
# Upstream resolves these through Conan (vendor/catboost/conanfile.py:16
# `requires("openssl/3.0.15")`, :19 `tool_requires("ragel/6.10")`, :21
# `tool_requires("yasm/1.3.0")`). Conan is a network resolver with no
# integrity pin this repository can audit, so it is removed from the install
# path entirely (spec 4.8 / catboost-8z4.13). Nothing below contacts the
# network: the tarballs are acquired once by
# tools/vendor/acquire-thirdparty.sh and their SHA256 is re-verified here,
# fail-closed, on every build.
#
# swig/4.0.2 is the fourth Conan tool_requires and is deliberately NOT
# handled: `find_package(SWIG ...)` occurs only under
# catboost/spark/catboost4j-spark/, which -DCATBOOST_COMPONENTS=R-package-fork
# never configures. Verified by grep over the pinned tree: the only
# find_package(SWIG) hits are the six spark CMakeLists.*.txt:17.
#
# ragel and yasm are BUILD-TIME code generators, not link inputs. The pinned
# tree hardcodes where it looks for them --
# vendor/catboost/cmake/common.cmake:26 `SET(RAGEL_BIN
# ${PROJECT_BINARY_DIR}/bin/ragel...)` and :43 `SET(YASM_BIN
# ${PROJECT_BINARY_DIR}/bin/yasm...)` -- with no cache variable to override,
# so the binaries are placed at exactly that path below. They are reached
# unconditionally by the yutil target the R package links
# (util/CMakeLists.linux-x86_64.txt:589 target_ragel_lexers for
# util/datetime/parser.rl6, :595 target_yasm_source for
# util/system/context_x86.asm). Building them from source rather than
# declaring them SystemRequirements is a deliberate choice: neither ships in
# a base CRAN build image, ragel 6.10 in particular is absent from current
# Debian/Ubuntu/Fedora repositories, and requiring the user to install two
# obscure code generators to compile an R package trades a 10-second build
# for an install that simply fails on most machines. Measured cost of
# building all three here: openssl ~10s, ragel ~5s, yasm ~2s at -j16.
#
# openssl IS a link input (accepted into the R1 link, not gated -- see
# SOURCES.md and docs/phase-1/P1.5-report.md). It is built static and
# -fPIC so it is embedded in libcatboostr.so; that embedding is exactly why
# SOURCES.md carries a standing CVE-tracking obligation for it.
# --------------------------------------------------------------------------
THIRDPARTY_SRC="${PKG_ROOT}/vendor/thirdparty"

# Keep these three in lockstep with tools/vendor/acquire-thirdparty.sh and
# SOURCES.md. They are duplicated rather than sourced from one file because
# configure must run standalone from an unpacked source tarball.
OPENSSL_VERSION="3.5.7"
OPENSSL_SHA256="a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8"
RAGEL_VERSION="6.10"
RAGEL_SHA256="5f156edb65d20b856d638dd9ee2dfb43285914d9aa2b6ec779dac0270cd56c3f"
YASM_VERSION="1.3.0"
YASM_SHA256="3dce6601b495f5b3d45b59f7d2492a340ee7e84b5beca17e48f862502bd5603f"

JOBS="${CATBOOSTR_JOBS:-4}"
TP_PREFIX="${CATBOOSTR_THIRDPARTY_PREFIX:-${WORKDIR}/thirdparty}"
TP_WORK="${WORKDIR}/thirdparty-build"

catboostr_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

# Fail-closed integrity gate. Every third-party byte that reaches the
# compiler passes through here first.
catboostr_verify_tarball() {
  _tb="${THIRDPARTY_SRC}/${1}-${2}.tar.gz"
  if [ ! -f "$_tb" ]; then
    echo "*** missing third-party source: $_tb" >&2
    echo "*** Run tools/vendor/acquire-thirdparty.sh once to fetch and verify it." >&2
    echo "*** This build will NOT download anything itself." >&2
    exit 1
  fi
  _actual=$(catboostr_sha256 "$_tb")
  if [ "$_actual" != "$3" ]; then
    echo "*** SHA256 MISMATCH for $1 $2 -- refusing to build." >&2
    echo "***   file    : $_tb" >&2
    echo "***   expected: $3" >&2
    echo "***   actual  : $_actual" >&2
    exit 1
  fi
  echo "*** verified $1 $2 sha256=$_actual"
}

catboostr_verify_tarball openssl "$OPENSSL_VERSION" "$OPENSSL_SHA256"
catboostr_verify_tarball ragel "$RAGEL_VERSION" "$RAGEL_SHA256"
catboostr_verify_tarball yasm "$YASM_VERSION" "$YASM_SHA256"

mkdir -p "$TP_WORK" "$TP_PREFIX"

# openssl: static, -fPIC (it is linked into a shared object), no zlib (the
# only reason zlib appeared in the Conan graph at all was openssl's default
# zlib option -- catboost itself has no find_package(ZLIB) anywhere and
# carries its own contrib/libs/zlib in-tree). build_libs + install_dev skips
# the apps and the man pages: nothing here needs the `openssl` CLI.
if [ ! -f "${TP_PREFIX}/lib/libcrypto.a" ]; then
  if ! command -v perl >/dev/null 2>&1; then
    echo "*** perl not found on PATH. openssl's own Configure is a Perl" >&2
    echo "*** program; it cannot be built without it." >&2
    exit 1
  fi
  echo "*** building pinned openssl ${OPENSSL_VERSION} (static, -fPIC)"
  rm -rf "${TP_WORK}/openssl-${OPENSSL_VERSION}"
  tar -xzf "${THIRDPARTY_SRC}/openssl-${OPENSSL_VERSION}.tar.gz" -C "$TP_WORK"
  (
    cd "${TP_WORK}/openssl-${OPENSSL_VERSION}" &&
    ./config --prefix="$TP_PREFIX" --openssldir="${TP_PREFIX}/ssl" --libdir=lib \
      no-shared no-tests no-docs no-zlib no-apps -fPIC &&
    make -j"$JOBS" build_libs &&
    make install_dev
  )
fi

# ragel 6.10: -std=c++03 is required, not cosmetic -- the shipped sources use
# `register` storage class and the implicit int/bool conversions that C++17
# removed, so a default-standard modern compiler rejects them.
if [ ! -x "${TP_PREFIX}/bin/ragel" ]; then
  echo "*** building pinned ragel ${RAGEL_VERSION}"
  rm -rf "${TP_WORK}/ragel-${RAGEL_VERSION}"
  tar -xzf "${THIRDPARTY_SRC}/ragel-${RAGEL_VERSION}.tar.gz" -C "$TP_WORK"
  (
    cd "${TP_WORK}/ragel-${RAGEL_VERSION}" &&
    CXXFLAGS="-O2 -std=c++03" ./configure --prefix="$TP_PREFIX" --disable-shared &&
    make -j"$JOBS" &&
    make install
  )
fi

# yasm 1.3.0: -std=gnu17 is required, not cosmetic -- libyasm/bitvect.h:86
# declares `typedef enum boolean { false = FALSE, true = TRUE }`, which C23
# (the default standard of current gcc/clang) rejects because false/true are
# keywords there. The two -Wno- flags cover the pre-C99 implicit
# declarations elsewhere in the tree.
if [ ! -x "${TP_PREFIX}/bin/yasm" ]; then
  echo "*** building pinned yasm ${YASM_VERSION}"
  rm -rf "${TP_WORK}/yasm-${YASM_VERSION}"
  tar -xzf "${THIRDPARTY_SRC}/yasm-${YASM_VERSION}.tar.gz" -C "$TP_WORK"
  (
    cd "${TP_WORK}/yasm-${YASM_VERSION}" &&
    CFLAGS="-O2 -std=gnu17 -Wno-implicit-function-declaration -Wno-int-conversion" \
      ./configure --prefix="$TP_PREFIX" --disable-shared --disable-python &&
    make -j"$JOBS" &&
    make install
  )
fi

# Hand the two generators to the pinned tree at the one path it looks at.
mkdir -p "${BUILD_DIR}/bin"
cp -f "${TP_PREFIX}/bin/ragel" "${BUILD_DIR}/bin/ragel"
cp -f "${TP_PREFIX}/bin/yasm" "${BUILD_DIR}/bin/yasm"
echo "*** ragel/yasm placed at ${BUILD_DIR}/bin (cmake/common.cmake:26,43)"

# --------------------------------------------------------------------------
# 4. Fork-owned toolchain file: forwards R's CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS
# into the CMake build (project-global CMAKE_*_FLAGS_INIT, not just the
# fork's own two translation units).
#
# The compiler BINARY is pinned to clang/clang++, NOT R's configured CC/CXX
# (verified: forwarding CC=gcc/CXX=g++ literally was attempted first and
# failed at TU 4/4265 -- vendor/catboost's generated CMakeLists.*.txt bake
# clang-only per-target compile flags (-fcolor-diagnostics,
# -faligned-allocation, -fdebug-default-version=4, -fuse-init-array,
# -Wimport-preprocessor-directive-pedantic, ...) unconditionally, independent
# of any toolchain file; gcc rejects them as unrecognized. Those flags live
# under the read-only vendor/catboost/ pin and cannot be edited. clang is
# therefore not a preference here, it is the only compiler the pinned tree's
# generated build files support -- see docs/phase-1/P1.4-report.md sec. 3b).
if ! command -v clang >/dev/null 2>&1 || ! command -v clang++ >/dev/null 2>&1; then
  echo "*** clang/clang++ not found on PATH. vendor/catboost's generated" >&2
  echo "*** CMakeLists.*.txt bake clang-only compile flags unconditionally" >&2
  echo "*** (verified by a failed gcc build -- see P1.4-report.md); only" >&2
  echo "*** clang can compile this pinned tree." >&2
  exit 1
fi

TOOLCHAIN_FILE="${WORKDIR}/r-toolchain.cmake"
cat > "$TOOLCHAIN_FILE" <<EOF
# Generated by catboostr's configure. Compiler is pinned to clang/clang++
# (see comment above this heredoc for why R's CC/CXX cannot be substituted).
# R's CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS ARE forwarded -- they are ordinary
# optimization/hardening flags, not compiler-specific ones.
set(CMAKE_C_COMPILER "clang")
set(CMAKE_CXX_COMPILER "clang++")
set(CMAKE_C_FLAGS_INIT "$R_CPPFLAGS $R_CFLAGS")
set(CMAKE_CXX_FLAGS_INIT "$R_CPPFLAGS $R_CXXFLAGS")
# -fuse-ld=lld matches vendor/catboost/build/toolchains/clang.toolchain
# (the ticket's proven invocation). Required, not cosmetic: verified by a
# real failed build that GNU ld's single-pass archive resolution cannot
# link contrib/libs/flatbuffers/flatc (liblibs-cxxsupp-libcxxabi-parts.a,
# which DEFINES __cxa_demangle, is listed before liblibs-cxxsupp-libcxxrt.a,
# which references it -- lld resolves this, ld does not). See
# docs/phase-1/P1.4-report.md sec. 3b for the exact repro.
if(NOT APPLE)
  set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld $R_LDFLAGS")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld $R_LDFLAGS")
else()
  set(CMAKE_EXE_LINKER_FLAGS_INIT "$R_LDFLAGS")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "$R_LDFLAGS")
endif()
set(CMAKE_C_STANDARD_LIBRARIES "-lc -lm")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc -lm")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
EOF

# --------------------------------------------------------------------------
# 5. Generator: Makefiles is the portable default; Ninja is used only when
# present on PATH (or CATBOOSTR_NINJA points at it). Upstream hardcoded
# -G Ninja unconditionally -- not inherited here.
# --------------------------------------------------------------------------
NINJA_BIN="${CATBOOSTR_NINJA:-}"
if [ -z "$NINJA_BIN" ] && command -v ninja >/dev/null 2>&1; then
  NINJA_BIN=$(command -v ninja)
fi

if [ -n "$NINJA_BIN" ]; then
  GENERATOR="Ninja"
  BUILD_CMD="$NINJA_BIN"
  EXTRA_CMAKE_ARGS="-DCMAKE_MAKE_PROGRAM=$NINJA_BIN"
else
  GENERATOR="Unix Makefiles"
  BUILD_CMD="make"
  EXTRA_CMAKE_ARGS=""
fi
# JOBS is set in section 3b -- the third-party builds there need it first.

PY3_BIN="${CATBOOSTR_PYTHON3:-}"
if [ -z "$PY3_BIN" ] && command -v python3 >/dev/null 2>&1; then
  PY3_BIN=$(command -v python3)
fi
CYTHON_BIN="${CATBOOSTR_CYTHON:-}"
if [ -z "$CYTHON_BIN" ] && command -v cython >/dev/null 2>&1; then
  CYTHON_BIN=$(command -v cython)
fi
if [ -z "$PY3_BIN" ] || [ -z "$CYTHON_BIN" ]; then
  echo "*** python3 and cython are required at configure time (needed by" >&2
  echo "*** vendor/catboost/cmake/{common,cython}.cmake for export-script" >&2
  echo "*** generation, unconditionally on every CMake configure)." >&2
  echo "*** Set CATBOOSTR_PYTHON3 / CATBOOSTR_CYTHON, or put them on PATH." >&2
  exit 1
fi

echo "*** generator: $GENERATOR"
echo "*** python3: $PY3_BIN"
echo "*** cython:  $CYTHON_BIN"

# --------------------------------------------------------------------------
# 6. Configure and build.
# --------------------------------------------------------------------------
GATE_FILE="${PKG_ROOT}/cmake/gate-test-tool-dirs.cmake"
# Conan is GONE from the install path. ${SRC_COPY}/cmake/conan_provider.cmake
# used to be the second entry here; it installed a CMake dependency provider
# that shelled out to `conan install` on the first find_package(), i.e. a
# network fetch with no integrity pin, during R CMD INSTALL. It is replaced
# by the fork's own provider, which resolves OpenSSL from the pinned,
# SHA256-verified build in section 3b and claims nothing else.
OPENSSL_TARGET_FILE="${PKG_ROOT}/cmake/openssl-target.cmake"

# shellcheck disable=SC2086
cmake -S "$SRC_COPY" -B "$BUILD_DIR" -G "$GENERATOR" -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN_FILE" \
  -DCMAKE_PROJECT_TOP_LEVEL_INCLUDES="${GATE_FILE};${OPENSSL_TARGET_FILE}" \
  -DCMAKE_POSITION_INDEPENDENT_CODE=On \
  -DCATBOOST_COMPONENTS=R-package-fork \
  -DHAVE_CUDA=no \
  -DCATBOOSTR_OPENSSL_ROOT="$TP_PREFIX" \
  -DCATBOOSTR_OPENSSL_VERSION="$OPENSSL_VERSION" \
  -DPython3_EXECUTABLE="$PY3_BIN" -DCYTHON_EXE="$CYTHON_BIN" \
  -DR_INCLUDE_DIR="$R_INCLUDE_DIR" \
  $EXTRA_CMAKE_ARGS

"$BUILD_CMD" -C "$BUILD_DIR" -j"$JOBS" catboostr

# --------------------------------------------------------------------------
# 7. Install the built shared object into inst/libs/, matching
# NAMESPACE's useDynLib(libcatboostr): R's install step copies inst/*
# verbatim into the installed package, so inst/libs/libcatboostr.so becomes
# <installed-pkg>/libs/libcatboostr.so. src/Makefile is a companion no-op so
# R CMD INSTALL's own src/ compile step does not also try (and fail) to
# compile src/*.cpp with R's bare SHLIB rules.
# --------------------------------------------------------------------------
OS_TYPE=$(uname)
BUILT_LIB="${BUILD_DIR}/catboostr-fork-build/libcatboostr.so"
if [ "$OS_TYPE" = "Darwin" ] && [ ! -f "$BUILT_LIB" ]; then
  BUILT_LIB="${BUILD_DIR}/catboostr-fork-build/libcatboostr.dylib"
fi
if [ ! -f "$BUILT_LIB" ]; then
  echo "*** build succeeded but the expected output ($BUILT_LIB) is missing." >&2
  exit 1
fi

mkdir -p inst/libs
cp -f "$BUILT_LIB" inst/libs/libcatboostr.so
echo "*** installed $BUILT_LIB -> inst/libs/libcatboostr.so"
